# GBT Pro — 配置模板（开发/预发/生产 都从这里复制一份）
# 任何敏感字段都必须用此处的 key 名；具体 value 由密钥管理器注入

# ── LLM 接入 ──
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-reasoner
DEEPSEEK_CHAT_MODEL=deepseek-chat

# 可选第三方
OPENAI_API_KEY=
ZHIPU_API_KEY=

# ── 通知 ──
TG_BOT_TOKEN=
TG_CHAT_ID=
SC_KEY=

# ── 部署面板 ──
GBT_RELEASE_TAG=dev
GBT_PORT=8765
GBT_BIND=0.0.0.0
GBT_PREVIEW_BASE_URL=http://127.0.0.1:18765
GBT_PROD_BASE_URL=http://127.0.0.1:8765

# ── 自动回滚阈值（预演 + 校验不通过即一键回滚） ──
GBT_ROLLBACK_HEALTH_FAILS=3
GBT_CONSISTENCY_TOLERANCE=0.02
